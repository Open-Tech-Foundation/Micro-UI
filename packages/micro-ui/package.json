{
  "name": "@opentf/micro-ui",
  "version": "0.8.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.min.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.js",
      "default": "./dist/index.min.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.min.css": "./dist/styles.min.css"
  },
  "files": [
    "dist",
    "docs"
  ],
  "description": "A tiny functional JavaScript UI library for AI agents to generate lightweight, interactive micro-apps. — no VDOM, no signals, no compiler",
  "repository": {
    "type": "git",
    "url": "git@github.com:Open-Tech-Foundation/Micro-UI.git"
  },
  "license": "MIT",
  "keywords": [
    "web-components",
    "micro-ui",
    "functional",
    "tiny",
    "ai-agents"
  ],
  "author": "Open Tech Foundation",
  "devDependencies": {
    "@opentf/esrun-types": "latest",
    "jsdom": "^25.0.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
